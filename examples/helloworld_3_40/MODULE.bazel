module(name = "helloworld_3_40")

bazel_dep(name = "com_clementguillot_rules_quarkus", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "com_clementguillot_rules_quarkus",
    path = "../..",
)

# Fix bazel 9.x issues
bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "rules_android", version = "0.7.1", repo_name = "rules_android")
bazel_dep(name = "rules_go", version = "0.61.0", repo_name = "rules_go")

# JVM rules
bazel_dep(name = "rules_java", version = "9.6.1")
bazel_dep(name = "rules_jvm_external", version = "6.10")

# The artifacts Quarkus extension descriptors name, which Maven cannot reach from the
# application's own dependencies: each runtime extension's deployment artifact, the
# extensions they activate conditionally, and the dev-mode bootstrap. They go into the
# Maven lock through maven.install, and quarkus.toolchain checks that a descriptor in
# the lock names each one.
QUARKUS_BUILD_TIME_ARTIFACTS = [
    "io.quarkus:quarkus-arc-deployment:3.40.1",
    "io.quarkus:quarkus-devui-deployment:3.40.1",
    "io.quarkus:quarkus-jacoco-deployment:3.40.1",
    "io.quarkus:quarkus-rest-deployment:3.40.1",
    "io.quarkus:quarkus-rest-kotlin-deployment:3.40.1",
    "io.quarkus:quarkus-arc-dev:3.40.1",
    "io.quarkus:quarkus-devui:3.40.1",
    "io.quarkus:quarkus-rest-dev:3.40.1",
    "io.quarkus:quarkus-rest-kotlin:3.40.1",
    "io.quarkus:quarkus-bootstrap-maven-resolver:3.40.1",
]

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "io.quarkus:quarkus-rest:3.40.1",
        "io.quarkus:quarkus-arc:3.40.1",
        # Test dependencies
        "io.quarkus:quarkus-junit:3.40.1",
        "io.quarkus:quarkus-jacoco:3.40.1",
        "io.rest-assured:rest-assured:5.5.6",
        "org.junit.jupiter:junit-jupiter:5.13.4",
        "org.junit.platform:junit-platform-console-standalone:1.13.4",
        "org.junit.platform:junit-platform-launcher:1.13.4",
    ] + QUARKUS_BUILD_TIME_ARTIFACTS,
    known_contributing_modules = [
        "bazel_worker_java",
        "protobuf",
    ],
    lock_file = "//:maven_install.json",
)
use_repo(maven, "maven")

quarkus = use_extension("@com_clementguillot_rules_quarkus//quarkus:extensions.bzl", "quarkus")
quarkus.toolchain(
    build_time_artifacts = QUARKUS_BUILD_TIME_ARTIFACTS,
    lock_file = "//:maven_install.json",
    quarkus_version = "3.40.1",
)
use_repo(quarkus, "rules_quarkus")
